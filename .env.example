# Environment Configuration for Client Activation Engine

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4096

# Application Settings
APP_NAME=Client Activation Engine
APP_VERSION=0.1.0
DEBUG=false

# Data Directories
DATA_INPUT_DIR=data/input
DATA_OUTPUT_DIR=data/output
LOGS_DIR=logs

# Sandbox Configuration
SANDBOX_TIMEOUT=30
SANDBOX_MAX_MEMORY=512MB
SANDBOX_ALLOWED_IMPORTS=pandas,numpy,matplotlib,seaborn,plotly,requests

# Orchestrator Settings
MAX_LOOP_ITERATIONS=50
TOOL_TIMEOUT=10
ENABLE_PARALLEL_TOOLS=true

# Client Tier Limits
STARTER_TIER_MAX_ASSETS=5
BUSINESS_TIER_MAX_ASSETS=20
PREMIUM_TIER_MAX_ASSETS=100
